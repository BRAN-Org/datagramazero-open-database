{
  "organization": {
    "name": "BRAN Org",
    "url": "https://github.com/BRAN-Org",
    "logo": "https://avatars.githubusercontent.com/u/328064865?v=4",
    "institutionName": "BRAN Org",
    "githubUrl": "https://github.com/BRAN-Org/datagramazero-open-database",
    "doiUrl": "https://doi.org/10.5281/zenodo.23593504",
    "issuesUrl": "https://github.com/BRAN-Org/datagramazero-open-database/issues"
  },
  "dataset": {
    "title": "DataGramaZero Open Database",
    "subtitle": "Acervo e Base de Dados Abertos",
    "description": "Base de dados bibliométrica aberta e acervo histórico completo dos 466 artigos e ensaios publicados na DataGramaZero - Revista de Ciência da Informação (1999-2015), periódico pioneiro de acesso aberto fundado pelo Prof. Aldo de Albuquerque Barreto e disponibilizado pela BRAN Org sob princípios FAIR e BOAI.",
    "version": "1.0.0",
    "doi": "10.5281/zenodo.23593504",
    "license": "Code: GNU GPLv3 | Data: CC BY-NC-SA 4.0 (Não-Comercial & Sem Treino Comercial de IA)",
    "entityName": "articles",
    "singularName": "Artigo",
    "pluralName": "Artigos",
    "primaryKey": "id",
    "secondaryKey": "doi"
  },
  "schema": {
    "searchFields": ["title", "title_en", "abstract", "abstract_en", "authors", "keywords", "keywords_en", "issue", "section"],
    "facets": [
      { "key": "year", "label": "Ano de Publicação", "type": "number", "multi": true, "targetField": "year" },
      { "key": "volume", "label": "Volume", "type": "number", "targetField": "volume" },
      { "key": "author", "label": "Autor / Pesquisador", "type": "string", "targetField": "authors" },
      { "key": "keyword", "label": "Palavra-chave / Tópico", "type": "string", "targetField": "keywords" },
      { "key": "issue", "label": "Edição / Fascículo", "type": "string", "targetField": "issue" }
    ],
    "sortFields": [
      { "key": "year", "label": "Ano" },
      { "key": "title", "label": "Título" },
      { "key": "volume", "label": "Volume" }
    ]
  },
  "stats": {
    "topLists": [
      { "key": "topAuthors", "label": "Principais Autores", "sourceField": "authors", "limit": 10 },
      { "key": "topKeywords", "label": "Palavras-chave Mais Frequentes", "sourceField": "keywords", "limit": 10 }
    ],
    "breakdowns": [
      { "key": "yearDistribution", "label": "Distribuição por Ano (1999-2015)", "sourceField": "year" },
      { "key": "volumeBreakdown", "label": "Distribuição por Volume", "sourceField": "volume" }
    ]
  }
}
