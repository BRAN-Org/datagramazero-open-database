# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Ensure critical data, code, and metadata files strictly preserve LF across all OS
*.json text eol=lf
*.csv text eol=lf
*.js text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.cff text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
*.tar.gz binary
