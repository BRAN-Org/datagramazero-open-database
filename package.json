{
  "name": "datagramazero-open-database",
  "version": "1.0.0",
  "description": "Base de dados bibliométrica aberta e API REST pública do acervo histórico da DataGramaZero - Revista de Ciência da Informação (1999-2015).",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/unit.test.js tests/api.test.js",
    "data:extract": "python scripts/extract_dgz.py",
    "data:convert": "node scripts/convert_csv_to_json.js",
    "data:validate": "node scripts/validate_dataset.js",
    "init:event": "node scripts/init_event.js"
  },
  "keywords": [
    "open-data",
    "bran-org",
    "api",
    "academic-data",
    "datagramazero",
    "aldo-barreto",
    "ciencia-da-informacao",
    "digital-preservation",
    "express"
  ],
  "author": "BRAN Org",
  "license": "GPL-3.0-or-later AND CC-BY-NC-SA-4.0",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0"
  }
}
