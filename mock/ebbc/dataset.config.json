{
  "organization": {
    "name": "BRAN Org",
    "url": "https://github.com/BRAN-Org",
    "logo": "https://avatars.githubusercontent.com/u/328064865?v=4",
    "institutionName": "Encontro Brasileiro de Bibliometria e Cientometria (EBBC 2012 - 2024)",
    "githubUrl": "https://github.com/GabrielBaiano/EBBC-OpenData",
    "doiUrl": "https://doi.org/10.5281/zenodo.0000000",
    "issuesUrl": "https://github.com/GabrielBaiano/EBBC-OpenData/issues"
  },
  "dataset": {
    "title": "EBBC OpenData - Acervo Histórico e Curadoria Metodológica",
    "description": "Base de dados aberta contendo todos os anais das edições do Encontro Brasileiro de Bibliometria e Cientometria (EBBC) de 2012 a 2024, com mapeamento detalhado de softwares, fontes de dados e etapas metodológicas aplicadas nas pesquisas cientométricas no Brasil.",
    "version": "1.4.0",
    "doi": "10.5281/zenodo.0000000",
    "license": "CC-BY 4.0 Open Access",
    "entityName": "articles",
    "singularName": "Artigo",
    "pluralName": "Artigos",
    "primaryKey": "doi",
    "secondaryKey": "id"
  },
  "schema": {
    "searchFields": ["title", "abstract", "authors", "keywords", "tools", "data_sources"],
    "facets": [
      { "key": "year", "label": "Edição / Ano", "type": "number", "multi": true, "targetField": "year" },
      { "key": "author", "label": "Autor", "type": "string", "targetField": "authors" },
      { "key": "tool", "label": "Ferramenta / Software", "type": "string", "targetField": "tools" },
      { "key": "source", "label": "Fonte de Dados", "type": "string", "targetField": "data_sources" },
      { "key": "stage", "label": "Etapa Metodológica", "type": "string", "targetField": "usage_stages" }
    ],
    "sortFields": [
      { "key": "title", "label": "Título" },
      { "key": "year", "label": "Ano de Edição" },
      { "key": "doi", "label": "DOI" }
    ]
  },
  "stats": {
    "topLists": [
      { "key": "topTools", "label": "Principais Softwares Utilizados", "sourceField": "tools", "limit": 10 },
      { "key": "topSources", "label": "Principais Fontes de Dados", "sourceField": "data_sources", "limit": 10 },
      { "key": "topAuthors", "label": "Autores Mais Frequentes", "sourceField": "authors", "limit": 10 }
    ],
    "breakdowns": [
      { "key": "yearDistribution", "label": "Distribuição por Edição", "sourceField": "year" },
      { "key": "stageBreakdown", "label": "Etapas Metodológicas", "sourceField": "usage_stages" }
    ]
  }
}
